################################################################################
# OpenRyoko systemd unit (Linux サーバー常駐用テンプレート)
#
# このテンプレートは「コピーして編集」前提です。最低限：
#   1. User= と Group= を実在するユーザーに（rootは強く非推奨）
#   2. WorkingDirectory= をそのユーザーのホームに
#   3. Environment=PATH= に Node.js (nvm 等) と CLI のディレクトリを追加
#   4. ExecStart= の `ryoko` をフルパスに置換
#
# 配置: /etc/systemd/system/openryoko.service
# 反映:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now openryoko
#   journalctl -u openryoko -f       # ログ追跡
################################################################################

[Unit]
Description=OpenRyoko AI Gateway (Slack/Discord/Web)
Documentation=https://github.com/rsensui2/OpenRyoko
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# ---- 実行ユーザー（重要） ----
# rootで起動すると Claude CLI が拒否します。childEnv.ts が
# IS_SANDBOX=1 を自動付与してバイパスはしますが、それでも
# 専用ユーザーで動かすことを強く推奨します。
User=ryoko
Group=ryoko
WorkingDirectory=/home/ryoko

# ---- PATH（spawn claude ENOENT 対策） ----
# systemd は最小 PATH しか継承しません。nvm 配下の node/npm/claude が
# PATH に無いと `spawn claude ENOENT` で死にます。実際のパスに合わせて編集。
Environment=NODE_ENV=production
Environment=PATH=/home/ryoko/.nvm/versions/node/v22.20.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Anthropic 公式 CLI が「rootでは動かしません」と弾くのを抑止する保険。
# childEnv.ts でも自動付与されますが、こちらで明示しておくと安全です。
Environment=IS_SANDBOX=1

# ---- 起動コマンド ----
# `which ryoko` で得たフルパスに置き換えてください。
ExecStart=/usr/local/bin/ryoko start

# ---- 自動再起動 ----
# クラッシュ時は5秒後に自動復旧。短時間で何度もクラッシュするとループするので、
# StartLimit で歯止めをかけています。
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

# ---- シャットダウン ----
KillMode=mixed
TimeoutStopSec=10

# ---- ログ ----
StandardOutput=journal
StandardError=journal
SyslogIdentifier=openryoko

# ---- セキュリティ強化（任意） ----
# 必要に応じてアンコメント。WhatsApp QR 表示やファイル添付で支障が出る場合は外してください。
# NoNewPrivileges=true
# PrivateTmp=true
# ProtectSystem=strict
# ProtectHome=read-only
# ReadWritePaths=/home/ryoko/.ryoko

[Install]
WantedBy=multi-user.target
